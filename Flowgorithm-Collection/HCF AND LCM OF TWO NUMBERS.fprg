<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="19)LCM (and hcf)"/>
        <attribute name="authors" value="Saud"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-22 06:22:01 PM"/>
        <attribute name="created" value="U2F1ZDtMRU5PVk87MjAyNi0wOC0xMjswNjoyMDowMiBQTTsyMTM5"/>
        <attribute name="edited" value="U2F1ZDtMRU5PVk87MjAyNi0wOC0yMjswNjoyMjowMSBQTTsyOzIyNTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A, B, LCM, HCF, i, min" type="Integer" array="False" size=""/>
            <comment text="LCM * HCF = A*B"/>
            <input variable="A"/>
            <input variable="B"/>
            <if expression="A&gt;B">
                <then>
                    <assign variable="min" expression="B"/>
                </then>
                <else>
                    <assign variable="min" expression="A"/>
                </else>
            </if>
            <for variable="i" start="1" end="min" direction="inc" step="1">
                <if expression="(a%i==0) and (b%i==0)">
                    <then>
                        <assign variable="HCF" expression="i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <assign variable="LCM" expression="(A*B)/HCF"/>
            <output expression="HCF" newline="True"/>
            <output expression="LCM" newline="True"/>
        </body>
    </function>
</flowgorithm>
